# ==============================================================
# Copie para ".env" SOMENTE para rodar no seu computador.
# No Render, estas variáveis são cadastradas no painel (Environment).
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).
# ==============================================================

# --- Banco de dados (TiDB Cloud) ---
# Cole a string de conexão do TiDB (botão "Connect" > "General"):
# DATABASE_URL=mysql://USUARIO.root:SENHA@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/test
DB_NAME=ong_piedade_db

# --- OU banco MySQL local (use no lugar de DATABASE_URL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# DB_SSL=true   # ligado automaticamente para hosts *.tidbcloud.com

# --- Segurança ---
# Texto longo e aleatório que assina os logins. No Render é gerado sozinho.
JWT_SECRET=troque-por-um-texto-bem-longo-e-aleatorio

# Administrador criado na PRIMEIRA vez que o sistema sobe (senha com 8+ caracteres).
ADMIN_EMAIL=admin@ongpiedade.org.br
ADMIN_PASSWORD=
ADMIN_NOME=Administrador ONG

# --- Opcionais ---
PORT=3000
# PIX_CHAVE=12588232000191
# PIX_CHAVE_EXIBICAO=12.588.232/0001-91 (CNPJ)
# CONTATO_PAGAMENTO=(81) 99265-5586
# CORS_ORIGINS=https://outro-dominio.com   # só se o site ficar em outro domínio
